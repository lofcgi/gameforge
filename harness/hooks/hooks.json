{
  "description": "gameforge 가드: 근거 없는 단계 승인, .env 읽기, 승인·심사 기록과 브리지 파일 수정, 블라인드 심사자의 범위 밖 읽기를 막는다. .gf 폴더가 있는 게임 프로젝트에서만 동작한다.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.py"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
